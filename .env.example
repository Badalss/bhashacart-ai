# WhatsApp Cloud API webhook credentials
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v24.0

# Tenant settings keyed by Meta WhatsApp phone number ID. Use per-store tokens.
# STORES_JSON='{"123456789012345":{"store_id":"00000000-0000-4000-8000-000000000001","shop_domain":"shop-name.myshopify.com","shopify_token":"replace-me","whatsapp_token":"replace-me","bulk_api_token":"replace-with-a-long-random-value","locale":"hi-IN","cod_template":"cod_confirmation","cod_template_language":"hi","cod_gateways":["Cash on Delivery (COD)"]}}'
STORES_JSON='{}'
SHOPIFY_API_VERSION=2026-07

# Gemini Developer API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
FAQ_MIN_SIMILARITY=0.88

# Default ASR and streaming TTS
SARVAM_API_KEY=
SARVAM_ASR_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
ASR_PROVIDER=sarvam
TTS_PROVIDER=sarvam
ASR_MIN_CONFIDENCE=0.8

# Optional Bhashini speech services. Copy the compute URL, auth header, key, and service IDs
# from pipeline discovery. Bhashini TTS provides a complete WAV response.
BHASHINI_COMPUTE_URL=
BHASHINI_AUTH_HEADER=Authorization
BHASHINI_API_KEY=
BHASHINI_ASR_SERVICES='{}'
BHASHINI_TTS_SERVICES='{}'
# BHASHINI_ASR_SERVICES='{"hi":"service-id","ta":"service-id","bn":"service-id","en":"service-id"}'

# Supabase runtime DSN. Use a login role that inherits bhashacart_app and require TLS.
SUPABASE_POSTGRES_DSN=

# Host process and Compose each use their own Valkey endpoint.
VALKEY_URL=redis://localhost:6379/0
COMPOSE_VALKEY_URL=redis://valkey:6379/0
API_PORT=8000

# Host runtime telemetry. Compose points the runtime at its own collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_COLLECTOR_CONFIG=./otel-collector.yml
# To export from Compose to Axiom, use ./otel-collector.axiom.yml above.
AXIOM_DOMAIN=api.axiom.co
AXIOM_API_TOKEN=
AXIOM_TRACES_DATASET=
AXIOM_METRICS_DATASET=
